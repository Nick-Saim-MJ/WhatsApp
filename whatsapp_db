END$$

CREATE DEFINER=`root`@`localhost` PROCEDURE `GetDailyStats` (IN `target_date` DATE)   BEGIN
    SELECT 
        COALESCE(COUNT(*), 0) as total_messages,
        COALESCE(SUM(CASE WHEN status = 'SENT' THEN 1 ELSE 0 END), 0) as sent_messages,
        COALESCE(SUM(CASE WHEN status = 'FAILED' THEN 1 ELSE 0 END), 0) as failed_messages,
        COALESCE(SUM(CASE WHEN file_url IS NOT NULL THEN 1 ELSE 0 END), 0) as messages_with_files
    FROM messages 
    WHERE DATE(created_at) = target_date;
END$$

